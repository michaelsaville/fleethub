# ─── Database ──────────────────────────────────────────────────────────────
# Shares the dochub Postgres instance via the `fleethub` schema.
DATABASE_URL=postgresql://dochub:CHANGE_ME@db:5432/dochub?schema=fleethub

# ─── NextAuth ──────────────────────────────────────────────────────────────
NEXTAUTH_URL=https://fleethub.pcc2k.com
NEXTAUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_32

# ─── Entra SSO (shared with DocHub + OpsHub — same app reg) ───────────────
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# ─── Cross-app BFF (Phase 1+) ──────────────────────────────────────────────
TICKETHUB_BASE_URL=https://tickethub.pcc2k.com
FL_BFF_SECRET=GENERATE_WITH_openssl_rand_-hex_32
# Public-facing URL used for drill-down links from /msp Tickets column.
# Defaults to https://tickethub.pcc2k.com when unset.
TICKETHUB_PUBLIC_URL=https://tickethub.pcc2k.com

# ─── Inbound (Phase 2+ — agent → FleetHub) ─────────────────────────────────
FLEETHUB_AGENT_SECRET=GENERATE_WITH_openssl_rand_-hex_32

# ─── Phase 7 Workstream A — default alert dispatch fallback ────────────────
# Slack incoming-webhook URL used when no Fl_AlertRoute matches an alert.
# When unset, unrouted alerts still create an Fl_Alert row + an
# Fl_AlertDispatch row with state="skipped-no-channel" so an operator can
# see the gap.
FLEETHUB_DEFAULT_ALERT_WEBHOOK_URL=

# ─── Phase 7 Workstream A step 5 — Twilio SMS adapter ──────────────────────
# All three required for the "sms" channel type to dispatch successfully.
# TWILIO_FROM_NUMBER must be in E.164 format (e.g. +14155551234) and must
# be a number the Twilio account owns. When any are unset, sms-channel
# dispatches fail with a clear "Twilio not configured" error.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Phase 5 step 13 — Ed25519 manifest signing for evidence-zip ──────────
# Generate with:
#   openssl genpkey -algorithm ed25519 -out fleethub-signing.pem
# Then paste the PEM here as a single line, encoding newlines as \n.
# When unset, evidence-zip manifests carry signature=null (step-11 v1
# behavior). The public key is exposed at /api/well-known/fleethub-signing-key.
FLEETHUB_SIGNING_PRIVATE_KEY_PEM=
