// FleetHub Prisma Schema
// Shares the existing dochub Postgres database with TicketHub, DocHub, OpsHub.
// All models prefixed Fl_ and live in the `fleethub` schema.
// Schema is additive only after first push — never rename or drop columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["fleethub"]
}

// ─── STAFF GATE ────────────────────────────────────────────────────────────

/// Per-app email allowlist for FleetHub access. Mirrors OpsHub's pattern;
/// intentionally separate so junior tech can have OpsHub access without
/// FleetHub access (or vice-versa).
model Fl_StaffUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("TECH") // ADMIN | TECH | VIEWER
  /// Phase 7 Workstream A step 8 — E.164 mobile for SMS dispatch when
  /// this user is the resolved on-call. Optional; staff without a
  /// phone are skipped during sms-channel resolution.
  phoneE164 String?
  isActive  Boolean  @default(true)
  /// Phase 9 WS-B §4.6 — TOTP MFA. When totpSecret is set, the
  /// NextAuth credentials provider requires a fresh 6-digit code
  /// (or a recovery code) after password verification. v1 is TOTP-
  /// only; WebAuthn deferred to Phase 10.
  totpSecret         String?
  totpEnabledAt      DateTime?
  /// 10 bcrypt'd one-time recovery codes, encoded as JSON array.
  recoveryCodesJson  String?
  /// When set on the user's row, MFA enrollment is required at next
  /// login. Per-tenant Fl_Tenant.mfaRequired forces this for all
  /// users on the tenant.
  mfaEnforcedAt      DateTime?
  /// Phase 11 WS-C §1 — failed mfa-verify counter. Reset on success.
  /// 5 failures within the lockout window triggers mfaLockedUntil.
  mfaFailCount       Int       @default(0)
  /// Phase 11 WS-C §1 — when set + future, every mfa-verify is rejected
  /// without checking the code. Cleared on lockout-window expiry.
  mfaLockedUntil     DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Per-staff saved views (column orderings, dashboard layouts, alert
  // filters). JSON blob keyed by view-id; UI saves whenever a tech
  // resizes a column or rearranges a widget. Per UI-PATTERNS.md, all
  // list state must persist — retrofitting it later is expensive.
  savedViewsJson String?

  @@map("fl_staff_users")
  @@schema("fleethub")
}

// ─── AUDIT LOG ─────────────────────────────────────────────────────────────

/// Append-only privileged-action log. Hash-chained per HIPAA-READY.md.
/// Drives the activity-log component on every detail page.
///
/// `prevHash` + `rowHash` form the chain: rowHash = SHA-256 of
/// (prevHash || actor || action || target || createdAt || detailJson).
/// Tampering with any historical row breaks the chain — verify on demand
/// via /api/audit/verify endpoint (Phase 1+).
///
/// Database role MUST be REVOKEd from DELETE/UPDATE on this table at
/// deploy time (Phase 1 deploy task).
model Fl_AuditLog {
  id            String   @id @default(cuid())
  actorEmail    String?
  /// Cross-app key (matches TH_Client.name; OpsHub Op_AuditLog uses same).
  clientName    String?
  /// Target host/device identifier (Fl_Device.id, hostname, or null for
  /// non-host actions like "client.connected").
  deviceId      String?
  /// Verb in dotted form: "agent.command.run", "patch.deploy.queued",
  /// "script.execute", "remote.session.opened", etc.
  action        String
  outcome       String  // "ok" | "error" | "pending"
  detailJson    String?
  prevHash      String?
  rowHash       String?
  /// Phase 11 WS-E — review-queue state. "unreviewed" by default; admin
  /// can flip to "reviewed" or "flagged" per row. Powers the
  /// "High-risk unreviewed" quick-range pill on /audit.
  reviewStatus  String   @default("unreviewed")
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([clientName, createdAt])
  @@index([deviceId, createdAt])
  @@index([action, createdAt])
  @@index([reviewStatus, createdAt])
  @@map("fl_audit_log")
  @@schema("fleethub")
}

// ─── DEVICES ───────────────────────────────────────────────────────────────

/// One row per host an agent connects from. Phase 1 fills basics
/// (hostname, OS, last seen); Phases 2-5 add inventory/patch/script
/// state (likely as JSON blobs on this row, plus dedicated tables for
/// time-series).
model Fl_Device {
  id            String    @id @default(cuid())
  /// Cross-app key — matches TH_Client.name.
  clientName    String
  hostname      String
  /// Operator-set human-readable label. Used to identify the user or
  /// role at a facility (e.g. "Reception desk · Sarah", "MD office #2",
  /// "Conference room AV"). Editable on /devices/[id]. Searchable in
  /// the /devices q box and the Cmd-K palette. Nullable so existing
  /// rows stay valid.
  friendlyName  String?
  os            String?   // "windows" | "linux" | "darwin"
  osVersion     String?
  /// Free-form: "DC", "workstation", "server", "laptop". Set by tech.
  role          String?
  ipAddress     String?
  /// FK to Op_Agent.id once an agent enrolls. Null until enrollment.
  agentId       String?
  isOnline      Boolean   @default(false)
  lastSeenAt    DateTime?
  /// Last hardware/software inventory snapshot — JSON blob, normalized
  /// into separate tables in Phase 1 if/when query needs surface.
  inventoryJson String?
  isActive      Boolean   @default(true)
  // Phase 3 — Maintenance Mode (NinjaOne-style toggle).
  // When true, software.* and patches.* commands are NOT dispatched and
  // alerts from this host are tagged suppressed. Walk-away-safe for
  // clinical procedure windows. See PHASE-3-DESIGN §7.
  maintenanceMode      Boolean   @default(false)
  maintenanceUntil     DateTime?
  maintenanceReason    String?
  maintenanceSetBy     String?
  // Phase 3 — set true when a deploy returned reboot-deferred.
  // Drained on next compatible window or explicit "Reboot now".
  pendingReboot        Boolean   @default(false)
  pendingRebootSince   DateTime?
  /// Phase 7 Workstream C — RustDesk peer ID for this host. Used
  /// in free-tier mode (no Pro license) to hand off a `rustdesk://`
  /// deep link to the operator's local client. In Pro mode it's
  /// also fetched from the management API; this column is the
  /// FleetHub-side cache so the device page doesn't round-trip on
  /// every load. Null until populated.
  rustdeskId    String?
  /// Phase 8 Workstream B — backup / AV / encryption / warranty
  /// posture. All nullable; only populated when the agent reports
  /// them. Point-in-time snapshot on each heartbeat — no separate
  /// sample table (the compliance score is computed from the last
  /// reported state, not a time series).
  backupLastSuccess  DateTime?
  backupLastError    DateTime?
  backupLastErrorMsg String?
  /// "veeam" | "datto" | "restic" | "windows-backup" | "none"
  backupProduct      String?
  /// "defender" | "crowdstrike" | "sophos" | "sentinelone" | "none"
  avEngine           String?
  avEnabled          Boolean?
  avSignaturesAt     DateTime?
  bitlockerOn        Boolean?
  warrantyExpiresAt  DateTime?
  /// Heartbeat timestamp from the most recent posture.* call.
  /// Lets the UI surface "posture stale" when this lags lastSeenAt
  /// significantly.
  postureReportedAt  DateTime?
  /// Phase 9 WS-C §5.2 — asset/warranty lifecycle. Operator-editable;
  /// agent never sets these. Drives "warranty expiring 90d" report
  /// and per-device asset-value rollup.
  assetTag           String?
  purchasedAt        DateTime?
  purchasePriceCents Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Phase 9 WS-C §5.4 — operator-initiated backup runs from /devices/[id].
  backupRuns   Fl_BackupRun[]
  /// Phase 9 WS-D §6.1 — interactive shell sessions.
  shellSessions Fl_ShellSession[]
  /// Phase 9 WS-D §6.2 — file transfers to/from this device.
  fileTransfers Fl_FileTransfer[]
  /// Phase 10 WS-C §5.6 — operator-authored markdown notes ("the
  /// admin pw is in vault under acme-router-admin", etc.).
  notes        Fl_DeviceNote[]

  @@unique([clientName, hostname])
  @@index([clientName, isOnline])
  @@index([os])
  @@index([maintenanceMode])
  @@map("fl_devices")
  @@schema("fleethub")
}

/// Per-tenant config singleton (FleetHub is single-tenant today, but
/// hipaaMode + signing keys + protected processes need a per-tenant
/// home so we don't have to re-seam later). One row per `clientName`
/// that we manage.
model Fl_Tenant {
  id                          String   @id @default(cuid())
  /// Matches TH_Client.name + Fl_Device.clientName.
  name                        String   @unique
  /// HIPAA mode flips: signed-script-only enforcement, signed-body
  /// enforcement on custom packages, dry-run-by-default-with-MFA.
  hipaaMode                   Boolean  @default(false)
  /// JSON array of base64 Ed25519 public keys. Multi-key for rotation.
  /// Used by agent to verify both Fl_Script.bodyEd25519Sig and
  /// Fl_Package.bodyEd25519Sig. See PHASE-2-DESIGN §3 + PHASE-3-DESIGN §11.
  scriptPublicKeysJson        String?
  /// JSON array of process basenames. When agent considers
  /// rebootPolicy=defer-if-user-active, presence of any of these
  /// processes blocks reboot regardless of console-session state.
  /// Default for healthcare: ["Dentrix.exe","eClinical*.exe","Eaglesoft*.exe"].
  protectedProcessNamesJson   String?
  defaultRingId               String?  // FK to Fl_DeployRing
  defaultPackageRebootPolicy  String   @default("defer-if-user-active")

  // Phase 7 Workstream C — remote control toggle. Defaults vary by
  // hipaaMode (operator picks at tenant-create time per the design;
  // the toggle here is the explicit value).
  remoteControlEnabled         Boolean @default(true)
  /// When true, every Fl_RemoteSession.create REQUIRES a non-empty
  /// justification string. Default-on for HIPAA-mode tenants.
  remoteRequiresJustification  Boolean @default(false)

  // Phase 7 Workstream D — customer-facing portal join. Off by
  // default; an admin flips it per-client to expose the fleet
  // page on portal.pcc2k.com/fleet/*.
  portalEnabled                Boolean @default(false)
  /// Max age (days) of report artifacts surfaced to the customer
  /// via /fleet/reports. Default 90 trims chatty history; HIPAA
  /// tenants may want this tighter, non-HIPAA may want unlimited
  /// (set to 9999).
  portalReportMaxAgeDays       Int     @default(90)

  // Phase 5 — per-tenant report branding.
  /// Logo for the report PDF cover. Path under /api/uploads/...
  reportLogoUrl       String?
  /// Hex accent color used in PDF section dividers + headline numbers.
  reportAccentColor   String  @default("#F97316")
  /// Optional footer text on every PDF page (compliance disclaimer, etc).
  reportFooterText    String?
  /// Days to retain generated artifacts. HIPAA default = 6 * 365.
  reportRetentionDays Int     @default(2190)
  /// Phase 5.5 — opt-in Claude API hook for QBR cover-page narrative.
  qbrAutoNarrative    Boolean @default(false)
  /// Phase 5.5 — Scout integration; lets Identity Posture report pull
  /// the latest IdentityAuditResults for this tenant from the Scout app.
  scoutTenantId       String?

  /// Phase 9 WS-B §4.6 — when true, every login on this tenant
  /// must present TOTP. Users without enrollment are redirected
  /// to /setup/staff/[id]?tab=mfa on next login.
  mfaRequired                          Boolean @default(false)
  /// Phase 9 WS-C §5.3 — opt-in per tenant. When true, the
  /// /api/cron/psa-sync writes endpoint counts to TicketHub
  /// TH_ContractItem.quantity for items with syncSource set.
  psaSyncEnabled                       Boolean @default(false)
  /// Phase 9 WS-C §5.4 — mutable backup trigger.
  backupTriggerEnabled                 Boolean @default(false)
  backupTriggerRequiresJustification   Boolean @default(true)
  /// Phase 9 WS-D §6.1 — interactive shell sessions.
  shellSessionsEnabled                 Boolean @default(false)
  shellRequiresJustification           Boolean @default(true)
  shellMaxDurationMin                  Int     @default(60)
  /// Phase 9 WS-D §6.2 — file transfer push/pull.
  fileTransferEnabled                  Boolean @default(false)
  fileTransferRequiresJustification    Boolean @default(true)
  fileTransferMaxSizeMb                Int     @default(100)
  /// Phase 10 WS-C §5.5 — IANA tz name for on-call schedule preview
  /// + future scheduling features. App-level default America/New_York
  /// when null.
  timezone                             String?

  /// Phase 11 WS-B — 4-eyes approval threshold for bulk dispatch.
  /// Bulk verbs touching > N devices route through Fl_ActionApproval.
  bulkApprovalThreshold                Int     @default(50)
  /// Phase 11 WS-A/B — when true, credential.disclose + credential.update
  /// route through 4-eyes approval (in addition to step-up auth).
  /// Default-on recommended for HIPAA tenants (Phase 11 §6 activation
  /// flips this for hipaaMode tenants).
  disclosureRequiresApproval           Boolean @default(false)
  /// Phase 11 WS-B — JSON array of device tag names. shell.open on
  /// devices carrying any of these tags routes through 4-eyes.
  /// Empty/null = no shell approval. Examples: ["prod","finance"].
  shellApprovalTagsJson                String?
  /// Phase 11 WS-D — max NextAuth session duration (hours). Defaults
  /// to 12 (matches mfa-cookie TTL); operator may shorten for HIPAA.
  sessionMaxHours                      Int     @default(12)
  /// Phase 11 WS-D — informational only in v1 (no enforcement);
  /// surfaces in Policies subtab for operator awareness.
  passwordExpiryDays                   Int     @default(0)
  /// Phase 12 WS-A — when true, the tenant has Fl_NetworkDevice rows
  /// being polled by the network-probe cron. Off-by-default so a new
  /// tenant doesn't enable polling without explicit opt-in.
  netmonEnabled                        Boolean @default(false)

  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("fl_tenants")
  @@schema("fleethub")
}

// ─── ALERTS ────────────────────────────────────────────────────────────────

/// Active and historical alerts. Each row is one event in a host's
/// timeline. Resolved alerts kept for 6+ years per HIPAA retention.
model Fl_Alert {
  id            String    @id @default(cuid())
  clientName    String
  deviceId      String?
  /// "ok->fail" transition that fired this alert: "disk.full",
  /// "service.down", "patch.failed", "agent.disconnected", etc.
  kind          String
  severity      String    // "info" | "warn" | "critical"
  title         String
  /// Optional machine-readable payload (e.g. service name + state).
  detailJson    String?
  state         String    @default("open") // "open" | "ack" | "resolved"
  ackedBy       String?
  ackedAt       DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  /// Phase 7 Workstream A — every alert can have N dispatch attempts
  /// (primary + escalation steps). Cascade-delete so resolved alerts
  /// don't leave orphan dispatch rows.
  dispatches    Fl_AlertDispatch[]

  @@index([clientName, state, createdAt])
  @@index([deviceId, state])
  @@index([severity, state])
  @@map("fl_alerts")
  @@schema("fleethub")
}

/// Phase 7 Workstream A — operator-defined routing rule for Fl_Alert.
/// Evaluated in priority order at write time; first match wins.
/// See PHASE-7-DESIGN.md §3.
model Fl_AlertRoute {
  id              String   @id @default(cuid())
  /// Null = applies to every tenant (default-fallback route). A
  /// specific tenant name takes priority over null entries.
  tenantName      String?
  /// JSON match predicate: {severity: "critical"|"warn"|"info"|[...],
  /// kindLike: "disk.*", deviceTag: "prod"}. Future fields stay
  /// backward-compatible.
  matchJson       String
  /// JSON channel list: [{type: "slack", webhookUrl, ...},
  /// {type: "sms", phoneNumbers: [...]}, {type: "ticket", board: ...}].
  channelsJson    String
  /// JSON escalation chain: [{afterMin: 5, channels: [...]},
  /// {afterMin: 15, channels: [...]}]. Null = no escalation.
  escalationJson  String?
  /// Per-route dedup window. Within this many minutes, a repeat of
  /// the same (alert.kind, alert.deviceId) is suppressed. 0 = off.
  dedupWindowMin  Int      @default(15)
  isActive        Boolean  @default(true)
  /// Lower priority = evaluated first. Ties broken by createdAt.
  priority        Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantName, priority, isActive])
  @@map("fl_alert_routes")
  @@schema("fleethub")
}

/// One row per outbound notification attempt. v1 step 1 ships
/// escalationStep=0 (primary dispatch); escalation chain lands in
/// step 4. ackedAt set by the signed-token ack endpoint (step 9).
model Fl_AlertDispatch {
  id              String    @id @default(cuid())
  alertId         String
  alert           Fl_Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)
  /// Null when the dispatch went through the hardcoded default
  /// fallback (no Fl_AlertRoute matched). Otherwise the matched
  /// route's id.
  routeId         String?
  channel         String    // "slack" | "teams" | "email" | "sms" | "pagerduty" | "ticket"
  /// Sanitized destination — webhook URL fingerprint, phone tail,
  /// ticket id, etc. Never the raw secret.
  destination     String
  state           String    // "pending" | "sent" | "failed" | "acked" | "skipped-deduped" | "skipped-no-channel"
  ackedAt         DateTime?
  ackedBy         String?
  /// Step in the escalation chain. 0 = primary; 1+ = escalation.
  escalationStep  Int       @default(0)
  /// Time after which this dispatch escalates. Null = no further.
  escalateAt      DateTime?
  /// External system reference — PD incident id, TH ticket id, etc.
  externalId      String?
  errorReason     String?
  createdAt       DateTime  @default(now())

  @@index([alertId, escalationStep])
  @@index([state, escalateAt])
  @@map("fl_alert_dispatches")
  @@schema("fleethub")
}

/// Phase 7 Workstream C — remote control session. One row per
/// "operator opened a session to a device" event. In Pro mode the
/// access token is minted via the RustDesk Pro management API
/// and bcrypt-hashed here so the raw token never lives at rest.
/// In free mode (no Pro license) accessTokenHash is null and
/// the session is operator-asserted: a "Mark as opened" + "Mark
/// as closed" pair on the device page drives the lifecycle.
model Fl_RemoteSession {
  id              String    @id @default(cuid())
  deviceId        String
  operatorEmail   String
  /// Pro-mode: session id returned by the RustDesk management
  /// API at open. Free-mode: null (no API to ask).
  rustdeskSessionId   String?
  /// Pro-mode: bcrypt of the one-time access token. Free-mode: null.
  accessTokenHash     String?
  accessTokenExpiresAt DateTime?
  /// HIPAA-mode justification. Required when the tenant has
  /// remoteRequiresJustification=true; null otherwise.
  justification   String?
  /// "issued" | "in-progress" | "closed" | "expired" | "revoked"
  state           String
  startedAt       DateTime?
  endedAt         DateTime?
  /// Bytes transferred over the RustDesk channel — Pro mode only;
  /// free mode leaves null. A long session that moved a lot of
  /// data is worth flagging on the audit page even when we
  /// can't reconstruct what moved.
  bytesTransferred BigInt?
  /// Operator-assertion mode marker — true when the close was
  /// recorded by the operator clicking "Mark as closed" rather
  /// than by the Pro API reporting an actual disconnect.
  assertedClose   Boolean   @default(false)
  createdAt       DateTime  @default(now())

  @@index([deviceId, createdAt])
  @@index([state, accessTokenExpiresAt])
  @@map("fl_remote_sessions")
  @@schema("fleethub")
}

/// Phase 7 Workstream B — auto-remediation runbooks. A runbook
/// matches alerts the same way an Fl_AlertRoute does (matchJson)
/// and runs a registered Fl_Script on the affected device. Nothing
/// arbitrary ever runs — Phase 2's signed-script lifecycle stays
/// intact. Each runbook is gated by a cooldown + a circuit breaker
/// so a misconfigured rule can't blow up the agent fleet.
model Fl_Runbook {
  id              String    @id @default(cuid())
  name            String
  description     String?
  /// JSON match predicate, same shape as Fl_AlertRoute.matchJson:
  /// {severity: ["critical"], kindLike: "disk.*"}.
  matchJson       String
  scriptId        String
  script          Fl_Script @relation(fields: [scriptId], references: [id])
  /// Minutes to wait between alert fire and runbook fire — lets a
  /// transient alert clear before anything runs.
  graceMin        Int       @default(2)
  /// Cooldown per (alert.kind, deviceId). The runbook won't fire
  /// for the same combo within this window. Critical to prevent
  /// fire-storm runaway.
  cooldownMin     Int       @default(30)
  /// Phase 7 WS-B step 5 — dry-run-first gate. v1 ships with this
  /// effectively unused (the dry-run + predicate flow lands in
  /// step 5); the field is here so step 5 doesn't need a schema
  /// change.
  dryRunFirst             Boolean @default(true)
  dryRunPredicateJson     String?
  /// Phase 7 WS-B step 4 — circuit breaker fields. Filled by the
  /// evaluator + the watcher; v1 step 1 doesn't read them yet.
  maxFiresPerHour         Int     @default(10)
  maxConsecutiveFailures  Int     @default(3)
  isTripped               Boolean @default(false)
  trippedReason           String?
  trippedAt               DateTime?
  isActive        Boolean   @default(true)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  fires           Fl_RunbookFire[]

  @@index([isActive, isTripped])
  @@map("fl_runbooks")
  @@schema("fleethub")
}

/// One row per runbook firing decision. State machine:
///   pending → (grace elapses) → running → (script run completes via
///   Fl_ScriptRun) state implicitly succeeded/failed by reading the
///   linked Fl_ScriptRun.state. Terminal skips: skipped-cooldown,
///   skipped-tripped, skipped-cleared (alert resolved during grace).
model Fl_RunbookFire {
  id              String     @id @default(cuid())
  runbookId       String
  runbook         Fl_Runbook @relation(fields: [runbookId], references: [id], onDelete: Cascade)
  /// Null when manually fired (Phase 7.5 "fire now" button).
  alertId         String?
  deviceId        String
  /// Mirror of the alert kind for cooldown lookups without a join.
  alertKind       String?
  /// Earliest time this fire is allowed to execute (createdAt +
  /// runbook.graceMin). The cron polls rows with state="pending"
  /// AND scheduledAt <= now.
  scheduledAt     DateTime
  state           String     // see model header
  dryRunScriptRunId   String?
  realScriptRunId     String?
  predicateOutcome    String?  // "pass" | "fail" | "skip"
  failureReason       String?
  createdAt       DateTime   @default(now())
  completedAt     DateTime?

  @@index([state, scheduledAt])
  @@index([runbookId, createdAt])
  @@index([alertId])
  @@map("fl_runbook_fires")
  @@schema("fleethub")
}

/// Phase 7 Workstream A step 8 — on-call rotations used by
/// alert-routing channels with `oncallScheduleId` set. The current
/// on-call is computed at dispatch time, not pre-resolved at
/// schedule-create time, so rotation edits take effect instantly.
/// Timezone is UTC across the board; DST-aware semantics are
/// punted to v1.5 per PHASE-7-DESIGN §12.
/// Phase 8 Workstream A — operator-authored alert threshold.
/// Cron-evaluates against telemetry tables (Fl_PerformanceSample;
/// Fl_InventorySample when WS-B lands) and emits Fl_Alert via the
/// existing writeAlert() helper. Every Phase 7 routing/escalation
/// /runbook reaction then fires as if the alert came from the agent.
model Fl_Monitor {
  id              String   @id @default(cuid())
  name            String
  /// Null = applies to all tenants.
  tenantName      String?
  /// Bounded metric set — one resolver per kind, declared in
  /// app/lib/monitor-evaluator.ts. Initial set covers perf.*; inv.*
  /// lands when Fl_InventorySample does.
  metric          String
  /// JSON predicate scoped to the metric. v1 shape:
  ///   { operator: "lt"|"gt"|"eq"|"neq", value: number,
  ///     osFilter?: "windows"|"linux"|"darwin",
  ///     deviceTag?: string,
  ///     forMin?: number  // sustain window (default 15) }
  predicateJson   String
  severity        String   // "critical" | "warn" | "info"
  /// Alert kind to emit. Operators can override (e.g. "disk.full")
  /// so the existing Fl_AlertRoute matchJson rules fire without a
  /// rebuild. Defaults to "monitor.<sanitized-name>" at create time.
  emitKind        String
  /// Cooldown per (deviceId, monitorId). 0 disables. Prevents
  /// flapping when the metric oscillates around the threshold.
  cooldownMin     Int      @default(30)
  isActive        Boolean  @default(true)
  /// Operator email/id who created this monitor. Free-text — no FK
  /// to Fl_StaffUser because monitors can outlive a staff row, and
  /// the deactivate-then-add reactivation flow would reuse the
  /// same email anyway.
  createdBy       String
  /// Bookkeeping the evaluator updates so the operator can see
  /// "this evaluated N seconds ago" on the detail page.
  lastEvaluatedAt DateTime?
  lastFiredAt     DateTime?
  fireCount       Int      @default(0)
  /// Phase 9 WS-C §5.1 — optional Fl_DeviceGroup scope. When set,
  /// the evaluator filters devices by group membership; when null,
  /// falls back to the tenantName + osFilter shape.
  scopeGroupId    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  fires           Fl_MonitorFire[]

  @@index([isActive, tenantName])
  @@map("fl_monitors")
  @@schema("fleethub")
}

/// Phase 8 Workstream A step 4 — inbound webhook endpoint for
/// third-party tools (UptimeRobot, Datadog, Sentry, …). Each row
/// owns its own opaque token at `/api/inbound/<token>`. A per-tool
/// mapper translates the incoming payload to the Fl_Alert shape,
/// then writeAlert() pipes into the existing routing.
model Fl_InboundWebhook {
  id              String    @id @default(cuid())
  name            String    // "Acme UptimeRobot"
  tenantName      String    // posts route to this tenant's channels
  /// Bounded source set — one mapper per source under
  /// app/lib/inbound-mappers/. New tools = new mapper file + a row.
  source          String    // "uptimerobot" | "datadog" | "sentry" | "generic"
  /// Opaque cuid-ish. Stored in plaintext because it IS the bearer —
  /// the URL `/api/inbound/<token>` is the only auth surface for
  /// sources that don't sign their requests.
  token           String    @unique
  /// JSON config the mapper consumes (severity-map overrides, kind
  /// prefixes, HMAC secret for sources that sign requests, etc.).
  /// Shape varies per source.
  configJson      String?
  isActive        Boolean   @default(true)
  lastFiredAt     DateTime?
  lastErrorAt     DateTime?
  lastError       String?
  fireCount       Int       @default(0)
  errorCount      Int       @default(0)
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([source, isActive])
  @@map("fl_inbound_webhooks")
  @@schema("fleethub")
}

/// Phase 8 Workstream A — per-(monitor, device) fire history.
/// Drives the recent-firings table on the monitor detail page +
/// is the cooldown lookup target (last fire per device).
model Fl_MonitorFire {
  id           String    @id @default(cuid())
  monitorId    String
  monitor      Fl_Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  deviceId     String
  /// Fl_Alert.id this fire produced; null if writeAlert failed.
  alertId      String?
  /// Snapshot of the value that crossed the threshold — for the
  /// detail-page "value was X when this fired" surfacing.
  observedValue Float?
  firedAt      DateTime  @default(now())

  @@index([monitorId, firedAt])
  @@index([monitorId, deviceId, firedAt])
  @@map("fl_monitor_fires")
  @@schema("fleethub")
}

model Fl_OncallSchedule {
  id              String   @id @default(cuid())
  name            String   // "Ops primary", "Healthcare on-call"
  /// JSON: array of { userId, dayOfWeek: 0-6 (Sunday=0), start: "HH:MM",
  /// end: "HH:MM" } slots. Multiple slots may cover the same moment —
  /// first match wins. Time-of-day is interpreted in `timezone` (Phase
  /// 12 WS-E.4) — falls back to UTC when null.
  rotationJson    String
  /// JSON: array of { userId, start: ISO8601, end: ISO8601, reason }
  /// override windows. Overrides take precedence over the rotation.
  overridesJson   String?
  /// Phase 12 WS-E.4 — IANA tz name (e.g. "America/New_York"). When
  /// set, rotationJson slot start/end times are interpreted in this
  /// tz with DST applied correctly. Null = legacy UTC behavior.
  timezone        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("fl_oncall_schedules")
  @@schema("fleethub")
}

// ─── SCRIPTS ───────────────────────────────────────────────────────────────

/// Script library — the "ComStore but curated" per UI-PATTERNS.md.
/// Each script is hash-pinned: signedHash is what the agent verifies
/// before execution. Editing a script creates a new revision; old
/// revisions retained for audit.
model Fl_Script {
  id            String   @id @default(cuid())
  /// Display name shown in the library.
  name          String
  /// "powershell" | "bash" | "batch".
  shell         String
  description   String?
  category      String?  // "maintenance" | "diagnostics" | "remediation" | ...
  tagsJson      String?  // ["disk", "windows", "remediation"]
  body          String   @db.Text
  /// SHA-256 of body, signed by an admin. Agent verifies before run.
  /// Per HIPAA-READY signed-script-only enforcement.
  signedHash    String
  signedBy      String?
  signedAt      DateTime?
  /// Whether this is in the "curated" set (visible in default library)
  /// or a private/draft script (only visible to creator). Curation gate
  /// per UI-PATTERNS — quality > quantity.
  isCurated     Boolean  @default(false)
  isActive      Boolean  @default(true)
  // Phase 2 additions (PHASE-2-DESIGN §9):
  /// Detached Ed25519 sig over signedHash by the tenant compliance key.
  /// Required when any tenant has hipaaMode=true.
  bodyEd25519Sig          String?
  /// SHA-256 of the body bytes. Recomputed by agent at exec time.
  bodySha256              String?
  /// HIPAA tenants enforce this; toggle for non-HIPAA "draft" scripts.
  requiresSignature       Boolean  @default(true)
  /// Some scripts can't honor dry-run (one-shot remediation, irreversible).
  /// When false, the run UI greys out the "apply" path entirely.
  dryRunCapable           Boolean  @default(true)
  /// e.g. "-WhatIf" (PowerShell) or "--dry-run" (bash). Passed as first
  /// arg by agent when dryRun=true.
  dryRunArg               String?
  /// JSON array of CAP_* names (Linux) the agent grants to the script
  /// child process. Empty = unprivileged.
  capabilitiesJson        String?
  /// JSON array of SeXxxPrivilege names (Windows JobObject).
  windowsPrivilegesJson   String?
  /// PHI-aware logging: when true, output may contain file content;
  /// agent only uploads transcript when tenant has explicit opt-in.
  outputContainsContent   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Phase 7 Workstream B — runbooks reference scripts. Back-relation.
  runbooks      Fl_Runbook[]

  @@index([category, isCurated])
  @@map("fl_scripts")
  @@schema("fleethub")
}

// ─── SCRIPT EXECUTIONS ─────────────────────────────────────────────────────

/// History of script runs. One row per (script, target host) pair.
/// Drives the "recent activity" cards on device detail pages.
/// Phase 2 doubles this row as the dispatcher state machine (per
/// PHASE-2-DESIGN, deviation: original spec'd separate Fl_ScriptCommand
/// + Fl_ScriptRunOutput tables, merged here for simplicity).
model Fl_ScriptRun {
  id            String    @id @default(cuid())
  scriptId      String
  deviceId      String
  /// Tech who initiated; null for cron/scheduled runs.
  initiatedBy   String?
  /// "queued" | "running" | "ok" | "error" | "timeout" | "cancelled" | "dryrun" | "rejected"
  state         String    @default("queued")
  /// stdout from agent (truncated to 64KB; full output in object storage).
  output        String?   @db.Text
  /// Phase 2: stderr capture, separate from stdout for deploy-monitor-style
  /// inline error display.
  stderr        String?   @db.Text
  exitCode      Int?
  /// Was this a dry run? Defaults true per HIPAA-READY.md; tech opts in.
  dryRun        Boolean   @default(true)
  // Phase 2 dispatch fields (PHASE-2-DESIGN §2 + §9):
  /// JSON: stringly-typed args passed to interpreter (quoted by agent).
  argsJson      String?
  /// JSON: additional env vars (CommonName, Tenant, etc.).
  envJson       String?
  /// Hard kill at this point (default 300s).
  timeoutSec    Int?
  /// Total bytes captured (any cap). When > inline cap, full transcript
  /// at outputUrl.
  outputBytes   Int?
  /// S3-compatible URL when output exceeds inline cap.
  outputUrl     String?
  /// SHA-256 of full transcript (any size).
  outputSha256  String?
  /// Reason if state=rejected ("script-sig-invalid", "script-body-tampered",
  /// "agent-offline", "device-maintenance-mode", etc.)
  rejectReason  String?
  durationMs    Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([deviceId, createdAt])
  @@index([scriptId, createdAt])
  @@index([state])
  @@map("fl_script_runs")
  @@schema("fleethub")
}

// ─── PHASE 3: SOFTWARE DEPLOYMENT ──────────────────────────────────────────

/// Catalog row. One per (tenant, package, OS) — Windows Chrome and
/// macOS Chrome are separate rows. Sources (winget/choco/brew/custom)
/// federate behind the row so the deploy UI doesn't fork by source.
/// See PHASE-3-DESIGN §3.
model Fl_Package {
  id              String   @id @default(cuid())
  tenantName      String   // Fl_Tenant.name
  name            String   // "Google Chrome"
  category        String?  // "browser" | "office" | "security" | "vertical" | …
  source          String   // "winget" | "choco" | "brew" | "custom"
  sourceId        String   // winget pkg id, choco id, brew formula, or "custom:<id>"
  os              String   // "windows" | "macos" | "linux" | "any"
  scope           String   @default("machine")  // "machine" | "user"
  dryRunCapable   Boolean  @default(true)
  /// "never" | "defer-if-user-active" | "force" | "schedule-window"
  rebootPolicy    String   @default("defer-if-user-active")
  /// HIPAA tenants enforce; agent verifies before install.
  signedBody      Boolean  @default(false)
  bodySha256      String?
  bodyEd25519Sig  String?
  /// Vendor metadata parsed at upload (custom MSI/PKG only):
  /// { productCode, upgradeCode, productVersion, bundleId, … }
  vendorMetadataJson String?
  /// Suggested at custom-MSI upload time; editable.
  silentInstallArgs   String?
  silentUninstallArgs String?
  /// JSON: detection rule (see PHASE-3-DESIGN §3.2).
  detectionRuleJson   String?
  isApproved      Boolean  @default(false) // operator must approve before deploy
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions        Fl_PackageVersion[]
  deployments     Fl_Deployment[]

  @@index([tenantName, archivedAt, name])
  @@index([source, sourceId])
  @@map("fl_packages")
  @@schema("fleethub")
}

/// Per-version row. Version pinning + custom-MSI artifact storage live here.
model Fl_PackageVersion {
  id                String   @id @default(cuid())
  packageId         String
  package           Fl_Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  version           String   // "122.0.6261.95"; vendor format, not parsed
  releaseDate       DateTime?
  /// Custom packages only: where the agent fetches the artifact.
  artifactUrl       String?
  artifactSha256    String?
  /// Server-pinned default for new deploys.
  isApprovedDefault Boolean  @default(false)
  createdAt         DateTime @default(now())

  @@unique([packageId, version])
  @@index([packageId, isApprovedDefault])
  @@map("fl_package_versions")
  @@schema("fleethub")
}

/// Update Ring. Per-tenant rollout shape (Action1 pattern).
/// Stages JSON (PHASE-3-DESIGN §5):
///   [{ name, selectorKind, selectorValue, abortFailureRate,
///      autoPromoteAfterSec, requiresApproval }, …]
model Fl_DeployRing {
  id              String   @id @default(cuid())
  tenantName      String
  name            String   // "Standard 4-stage", "Healthcare conservative"
  stagesJson      String   @db.Text
  isDefault       Boolean  @default(false)
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deployments     Fl_Deployment[]

  @@index([tenantName, isDefault])
  @@map("fl_deploy_rings")
  @@schema("fleethub")
}

/// One deployment = one (package, version, action, ring) execution.
/// Targets are spread across stages defined by the ring.
model Fl_Deployment {
  id                  String   @id @default(cuid())
  tenantName          String
  packageId           String
  package             Fl_Package @relation(fields: [packageId], references: [id])
  packageVersionId    String
  ringId              String
  ring                Fl_DeployRing @relation(fields: [ringId], references: [id])
  /// "install" | "uninstall" | "update"
  action              String
  /// "queued" | "running" | "paused" | "auto-paused" | "completed" | "aborted"
  status              String   @default("queued")
  dryRun              Boolean  @default(true)
  /// Optional override. Null = use Fl_Package.rebootPolicy.
  rebootPolicyOverride String?
  scheduledFor        DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  pausedAt            DateTime?
  pauseReason         String?
  requestedBy         String   // operator email
  totalTargets        Int      @default(0)
  succeededCount      Int      @default(0)
  failedCount         Int      @default(0)
  noOpCount           Int      @default(0)
  pendingCount        Int      @default(0)
  rebootDeferredCount Int      @default(0)
  /// Stage we're currently dispatching (or last completed stage if paused).
  currentStage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  targets             Fl_DeploymentTarget[]

  @@index([tenantName, status, createdAt])
  @@index([packageId, createdAt])
  @@map("fl_deployments")
  @@schema("fleethub")
}

/// One Fl_DeploymentTarget = one host slice of one Fl_Deployment.
model Fl_DeploymentTarget {
  id                  String   @id @default(cuid())
  deploymentId        String
  deployment          Fl_Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
  deviceId            String
  stageName           String   // matches Fl_DeployRing.stagesJson[].name
  /// "pending" | "dispatched" | "running" | "succeeded" | "failed"
  ///   | "no-op" | "reboot-deferred" | "skipped"
  status              String   @default("pending")
  attemptCount        Int      @default(0)
  exitCode            Int?
  durationMs          Int?
  detectedVersionPre  String?
  detectedVersionPost String?
  /// Last 4 KiB of stderr — inline so deploy monitor doesn't drill.
  stderrTail          String?  @db.Text
  /// Last status message from agent ("Downloading 12.4 / 18.6 MB").
  progressMessage     String?
  progressPercent     Int?
  outputUrl           String?  // S3 if exceeded inline cap
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([deploymentId, status])
  @@index([deviceId, createdAt])
  @@map("fl_deployment_targets")
  @@schema("fleethub")
}

// ─── PHASE 4: PATCH MANAGEMENT ─────────────────────────────────────────────

/// Patch catalog row. Global per (source, sourceId) — catalog is shared
/// across tenants (KB5036893 is the same patch everywhere). Per-tenant
/// approval lives on the row for v1; multi-tenant approval needs a
/// separate Fl_PatchApproval table — Phase 4.5 deviation.
/// See PHASE-4-DESIGN §3.
model Fl_Patch {
  id                String   @id @default(cuid())
  /// "ms" | "thirdparty" | "custom"
  source            String
  /// "KB5036893" / "Adobe.Acrobat.DC@..." / "custom:<id>"
  sourceId          String
  os                String   // "windows" | "macos" | "linux" | "any"
  title             String
  /// "security" | "critical" | "definition" | "feature" | "rollup"
  /// | "driver" | "third-party"
  classification    String
  /// JSON: ["CVE-2026-XXXX", ...]. Empty for non-security.
  cveJson           String?
  /// Highest CVSS v3.1 base score across cveJson. 0-10.
  cvssMax           Float?
  /// CISA Known Exploited Vulnerabilities. Bumps priority hard.
  isKev             Boolean  @default(false)
  /// Server 2025 / Win 11 hotpatch — install without reboot.
  isHotpatch        Boolean  @default(false)
  requiresReboot    Boolean?
  /// JSON: array of Fl_Patch.id strings this patch supersedes.
  supersedesIdsJson String?
  /// Custom only: artifact + sig + detection.
  artifactUrl       String?
  artifactSha256    String?
  bodyEd25519Sig    String?
  /// JSON detection rule (PHASE-4-DESIGN §5.3)
  detectionRuleJson String?
  /// "approved" | "declined" | "needs-approval" | "deferred" | "auto-declined"
  approvalState     String   @default("needs-approval")
  approvedBy        String?
  approvedAt        DateTime?
  notes             String?
  publishedAt       DateTime?
  ingestedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt
  installs          Fl_PatchInstall[]

  @@unique([source, sourceId])
  @@index([approvalState, isKev, cvssMax])
  @@index([os, classification])
  @@map("fl_patches")
  @@schema("fleethub")
}

/// CVE/advisory metadata. Hourly cron pulls NVD JSON 2.0 + CISA KEV.
/// Linked to patches via Fl_Patch.cveJson string-array (denormalized
/// for fast read; ingest cron is the keeper of consistency).
model Fl_PatchAdvisory {
  id           String   @id @default(cuid())
  cveId        String   @unique  // "CVE-2026-XXXX"
  cvssBase     Float?
  cvssVector   String?
  isKev        Boolean  @default(false)
  kevAddedAt   DateTime?
  /// Vendor named in the CISA KEV catalog ("Microsoft", "Adobe", ...)
  vendor       String?
  product      String?
  description  String?  @db.Text
  /// Recommendations from CISA KEV when present.
  ransomwareUseKnown Boolean @default(false)
  publishedAt  DateTime?
  /// JSON: ["confidentiality","integrity","availability"]
  impactJson   String?
  ingestedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isKev, cvssBase])
  @@index([kevAddedAt])
  @@map("fl_patch_advisories")
  @@schema("fleethub")
}

/// Per-host per-patch state. Real population happens via patches.scan
/// + patches.detect agent calls. v1 ships with mock-seeded rows so
/// the Vulnerable dashboard renders against real-shaped data.
/// See PHASE-4-DESIGN §12.
model Fl_PatchInstall {
  id                  String   @id @default(cuid())
  deviceId            String
  patchId             String
  patch               Fl_Patch @relation(fields: [patchId], references: [id], onDelete: Cascade)
  /// "installed" | "missing" | "failed" | "superseded" | "declined"
  /// | "preflight-failed" | "rollback-failed" | "detection-disagreement"
  state               String
  /// Per-method detection result. Null when method wasn't run.
  /// Cross-check on Windows for the "agent says yes, OS says no" case.
  wmiQfe              Boolean?
  dismPackages        Boolean?
  wuHistory           Boolean?
  lastDetectedAt      DateTime
  /// Deployment that put this patch on the host (when known).
  installingDeploymentId String?
  installedAt         DateTime?
  failureReason       String?
  /// Free-text from the agent (DISM error, wusa exit code, etc).
  rawDetail           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([deviceId, patchId])
  @@index([state, lastDetectedAt])
  @@index([deviceId, state])
  @@map("fl_patch_installs")
  @@schema("fleethub")
}

/// Saved target group. Created from the deploy form's
/// "Save these targets as a Group" inline action, or manually on /groups.
model Fl_DeviceGroup {
  id                String   @id @default(cuid())
  tenantName        String
  name              String
  /// Dynamic membership (RQL fragment). Re-evaluated at use time.
  rql               String?
  /// Static membership (JSON: array of Fl_Device.id strings).
  pinnedDeviceIdsJson String?
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantName, name])
  @@map("fl_device_groups")
  @@schema("fleethub")
}

// ─── PHASE 5: REPORTS ──────────────────────────────────────────────────────

/// One generated report artifact. Operator-initiated rows arrive in
/// state="queued" and the render worker (today: synchronous in the
/// generate API route) drives them through generating → ready. Scheduled
/// generation (Fl_ReportSchedule) is Phase 5.5; v1 is ad-hoc only.
model Fl_Report {
  id             String   @id @default(cuid())
  /// "patch-compliance" | "software-inventory" | "performance-trend"
  /// | "identity-posture" | "qbr"
  kind           String
  tenantName     String
  /// "tech" | "client" | "auditor" — toggles which sections render.
  audience       String   @default("client")
  /// Inclusive ISO date range. Some reports are point-in-time
  /// snapshots (asOf); others are intervals (start..end).
  asOf           DateTime?
  startDate      DateTime?
  endDate        DateTime?
  /// "pdf" | "csv" | "json" | "evidence-zip"
  format         String   @default("pdf")
  /// Local filesystem path under /uploads/reports/ for v1; S3-compatible
  /// URL once the storage swap-out lands. Null until state=ready.
  artifactUrl    String?
  artifactSha256 String?
  artifactBytes  Int?
  /// Generation context — cron schedule id (when scheduled) or
  /// operator email (when ad-hoc).
  generatedBy    String
  scheduleId     String?
  /// "queued" | "generating" | "ready" | "delivered" | "failed" | "expired"
  state          String   @default("queued")
  failureReason  String?
  /// state="expired" + artifactUrl cleared after this date. Defaults
  /// derive from Fl_Tenant.reportRetentionDays at create time.
  retentionUntil DateTime
  generatedAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([tenantName, kind, createdAt])
  @@index([state, retentionUntil])
  @@map("fl_reports")
  @@schema("fleethub")
}

/// Per-host aggregated performance samples. Agent's existing
/// inventory.report push (every 15min) feeds the row-level columns; a
/// server-side cron rolls 15-min samples → 1h, 1h → 1d, 1d → 7d.
/// Tier retention: 1h kept 30d, 1d kept 13mo, 7d kept 6 years.
model Fl_PerformanceSample {
  id               String   @id @default(cuid())
  deviceId         String
  /// Aggregation window. "1h" | "1d" | "7d"
  window           String
  /// Window start (inclusive). UTC.
  windowStart      DateTime
  cpuAvgPct        Float
  cpuP95Pct        Float
  ramAvgPct        Float
  ramP95Pct        Float
  diskUsedPct      Float
  /// Network bytes-in/out summed across interfaces.
  netInBytes       BigInt   @default(0)
  netOutBytes      BigInt   @default(0)
  uptimeSec        BigInt   @default(0)
  /// Count of agent.heartbeat misses in this window — gaps in
  /// monitoring affect report confidence.
  missedHeartbeats Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([deviceId, window, windowStart])
  @@index([window, windowStart])
  @@map("fl_performance_samples")
  @@schema("fleethub")
}

/// Cron'd report generation + delivery. Per PHASE-5-DESIGN §5.
/// One row per (tenant, kind, cadence) trio; the cron worker fans these
/// out into Fl_Report rows on each fire. delivery JSON carries email
/// recipients + (Phase 5.5) Slack/Teams webhook config.
model Fl_ReportSchedule {
  id            String    @id @default(cuid())
  tenantName    String
  /// Matches Fl_Report.kind: "patch-compliance" | "software-inventory"
  /// | "performance-trend" | "qbr" | "identity-posture"
  kind          String
  audience      String    @default("client")
  format        String    @default("pdf")
  /// Cron expression interpreted in `timezone`.
  cron          String
  timezone      String    @default("UTC")
  /// Date-range relative to scheduled fire time. See §5:
  /// "last-7d" | "last-30d" | "last-90d" | "month-to-date" | "quarter-to-date"
  dateRange     String    @default("last-30d")
  /// JSON: { email?: { to: string[], cc?: string[] }, slack?: { webhookUrl: string } }
  /// v1 only honors email.* (Phase 5.5 adds slack delivery).
  deliveryJson  String
  isActive      Boolean   @default(true)
  /// Last successful fire — used to detect skew and to gate the next fire.
  lastFiredAt   DateTime?
  /// Last failure surface so the operator can see why a schedule stopped
  /// firing without trawling logs.
  lastErrorAt   DateTime?
  lastError     String?
  createdBy     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantName, isActive])
  @@index([isActive, lastFiredAt])
  @@map("fl_report_schedules")
  @@schema("fleethub")
}

// ─── PHASE 9 WS-C §5.4 — MUTABLE BACKUP TRIGGER ──────────────────────────

/// Operator-initiated backup. The agent runs the appropriate
/// per-product binary (Veeam CLI / wbadmin / restic) keyed by
/// the device's posture-detected backupProduct. Audit-row written
/// on trigger + completion. Per-tenant gate via
/// Fl_Tenant.backupTriggerEnabled.
model Fl_BackupRun {
  id            String   @id @default(cuid())
  deviceId      String
  device        Fl_Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// One of "veeam" | "datto" | "restic" | "windows-backup".
  /// Mirrors the device's last-known backupProduct at trigger time.
  product       String
  triggeredBy   String
  justification String?
  /// "queued" | "running" | "completed" | "failed" | "cancelled"
  state         String
  startedAt     DateTime?
  completedAt   DateTime?
  errorMsg      String?
  createdAt     DateTime @default(now())

  @@index([deviceId, createdAt(sort: Desc)])
  @@map("fl_backup_runs")
  @@schema("fleethub")
}

// ─── PHASE 9 WS-D §6.1 — INTERACTIVE SHELL ───────────────────────────────

/// One operator-initiated interactive shell session. The agent
/// spawns the appropriate shell (powershell.exe / bash) and pipes
/// stdin/stdout via a WSS stream channel. No content is recorded
/// — only stats. Per-tenant gate via Fl_Tenant.shellSessionsEnabled.
model Fl_ShellSession {
  id              String   @id @default(cuid())
  deviceId        String
  device          Fl_Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  operatorEmail   String
  justification   String?
  openedAt        DateTime @default(now())
  closedAt        DateTime?
  /// "open" | "closed" | "timeout" | "agent-disconnected"
  state           String
  bytesTx         Int      @default(0)
  bytesRx         Int      @default(0)
  /// "operator" | "timeout" | "disconnect" | "error"
  exitReason      String?

  @@index([deviceId, openedAt(sort: Desc)])
  @@map("fl_shell_sessions")
  @@schema("fleethub")
}

// ─── PHASE 9 WS-D §6.2 — FILE TRANSFER ───────────────────────────────────

/// One push or pull file transfer. Push: operator → agent
/// (signed-URL bucket, agent fetches). Pull: agent → operator
/// (chunked upload to server, operator downloads). sha256-gated.
/// Per-tenant gate via Fl_Tenant.fileTransferEnabled.
model Fl_FileTransfer {
  id              String   @id @default(cuid())
  deviceId        String
  device          Fl_Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// "push" | "pull"
  direction       String
  remotePath      String
  /// Operator-side temp path; null on push until completion.
  localPath       String?
  sha256          String?
  sizeBytes       Int?
  /// "queued" | "transferring" | "completed" | "failed" | "cancelled"
  state           String
  requestedBy     String
  justification   String?
  errorMsg        String?
  requestedAt     DateTime @default(now())
  completedAt     DateTime?

  @@index([deviceId, requestedAt(sort: Desc)])
  @@map("fl_file_transfers")
  @@schema("fleethub")
}

// ─── PHASE 10 WS-C §5.6 — DEVICE/TENANT NOTES (KB-lite) ──────────────────

/// Per-device markdown note. Sanitized via DOMPurify on the client
/// before render. Soft-delete via deletedAt so historical notes
/// retain context across staff turnover. Pinned notes float to the
/// top of the device summary.
model Fl_DeviceNote {
  id          String    @id @default(cuid())
  deviceId    String
  device      Fl_Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  body        String
  isPinned    Boolean   @default(false)
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([deviceId, deletedAt, isPinned])
  @@map("fl_device_notes")
  @@schema("fleethub")
}

/// Per-tenant markdown note. Same shape as Fl_DeviceNote but keyed
/// by tenant. Used for "the router admin pw is in vault" and similar
/// tenant-level operational context.
model Fl_TenantNote {
  id           String    @id @default(cuid())
  tenantName   String
  body         String
  isPinned     Boolean   @default(false)
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantName, deletedAt, isPinned])
  @@map("fl_tenant_notes")
  @@schema("fleethub")
}

// ─── PHASE 11 — CRYPTO + VAULT ──────────────────────────────────────────────

/// Phase 11 WS-A. Single source of truth for every server-side secret.
/// Purposes: vault-kek (symmetric; wraps per-tenant DEKs),
/// approval-signing (HMAC; signs 4-eyes approval tokens),
/// ack-signing (HMAC; signs Phase 7 alert-ack URLs — migrated),
/// step-up-signing (HMAC; signs WS-C step-up tokens),
/// webauthn-rp (asymmetric; the RP keypair for WebAuthn).
///
/// Symmetric/HMAC keys: keyMaterial is the key bytes wrapped by
/// FLEETHUB_CRYPTO_ROOT_KEY using AES-256-GCM. Asymmetric keys:
/// publicKey holds the raw public bytes; keyMaterial holds the
/// private key wrapped by the root.
///
/// Rotation: insert a new row with version+1, retire the old by
/// setting retiredAt. Both rows are kept; the active reader uses
/// max(version) where retiredAt is null.
model Fl_CryptoKey {
  id            String    @id @default(cuid())
  purpose       String    // vault-kek | approval-signing | ack-signing | step-up-signing | webauthn-rp
  algorithm     String    // aes-256-gcm | hmac-sha256 | ed25519
  /// Wrapped private/symmetric key bytes (wrap = AES-256-GCM under root key).
  keyMaterial   Bytes
  /// Raw public key bytes. Null for symmetric/HMAC keys.
  publicKey     Bytes?
  version       Int
  createdAt     DateTime  @default(now())
  createdBy     String
  retiredAt     DateTime?
  notes         String?

  @@unique([purpose, version])
  @@index([purpose, retiredAt])
  @@map("fl_crypto_keys")
  @@schema("fleethub")
}

/// Phase 11 WS-A. Encrypted credential entry per tenant. Read-side
/// requires step-up token + (if disclosureRequiresApproval) 4-eyes.
/// Server-internal callers (alert-channels, future SNMP) use
/// unsealForSystemUse which writes the disclosure log without
/// requiring step-up.
model Fl_Credential {
  id              String    @id @default(cuid())
  tenantName      String
  /// Kind enum: admin-pw | api-key | wifi-psk | snmp-v3 | smtp-password | webhook-secret | other
  kind            String
  label           String
  /// AES-256-GCM ciphertext of the plaintext secret.
  ciphertext      Bytes
  /// 12-byte GCM nonce.
  nonce           Bytes
  /// Fl_CryptoKey.version for purpose='vault-kek' used to derive the DEK.
  keyVersion      Int
  /// Optional rotation reminder.
  rotateBy        DateTime?
  lastAccessedAt  DateTime?
  /// When this credential was replaced by a newer version (rotation).
  /// Replaced rows are kept for forensics; reads filter replacedAt = null.
  replacedAt      DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  disclosures     Fl_CredentialDisclosureLog[]

  @@index([tenantName, kind, replacedAt])
  @@index([tenantName, replacedAt])
  @@map("fl_credentials")
  @@schema("fleethub")
}

/// Phase 11 WS-A. Every time a credential is disclosed (UI or system),
/// a row lands here. This is the ONLY surface where disclosure history
/// can be queried — the main Fl_AuditLog disclose row never carries
/// plaintext (redacted by withAudit allowlist).
model Fl_CredentialDisclosureLog {
  id             String         @id @default(cuid())
  credentialId   String
  credential     Fl_Credential  @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  viewedBy       String
  viewedAt       DateTime       @default(now())
  /// Free-text justification from the operator (UI disclose) or a tag
  /// like "system:alert-channels" for server-internal use.
  justification  String
  ip             String?
  userAgent      String?
  /// "ui-disclose" | "ui-copy-to-clipboard" | "system:alert-channels" | etc.
  context        String

  @@index([credentialId, viewedAt])
  @@index([viewedBy, viewedAt])
  @@map("fl_credential_disclosure_log")
  @@schema("fleethub")
}

// ─── PHASE 11 — APPROVAL WORKFLOW ───────────────────────────────────────────

/// Phase 11 WS-B. 4-eyes approval state machine. Created by
/// lib/approval-gate.ts:requireApproval(); consumed by consumeApproval()
/// after approver clicks Approve in /approvals inbox.
///
/// payloadHash is captured at request time and verified at consume
/// time — protects against payload swap-after-approval.
///
/// Transitions: pending → approved | denied | expired
///              approved → consumed (one-way, race-safe)
model Fl_ActionApproval {
  id            String    @id @default(cuid())
  /// Verb: bulk.dispatch | shell.open | credential.disclose | credential.update
  ///       | alert-route.delete | oncall-schedule.delete
  action        String
  tenantName    String
  /// Canonical JSON of the action's input payload.
  payloadJson   String
  /// SHA-256 hex of payloadJson — anti-swap guard.
  payloadHash   String
  requestedBy   String
  requestedAt   DateTime  @default(now())
  /// Optional UI scope label (tag name, group id, route id).
  scope         String?
  requiredRole  String    @default("ADMIN")
  state         String    @default("pending") // pending | approved | denied | expired | consumed
  approverEmail String?
  approvedAt    DateTime?
  denyReason    String?
  consumedAt    DateTime?
  expiresAt     DateTime

  @@index([state, expiresAt])
  @@index([tenantName, state, requestedAt])
  @@index([requestedBy, requestedAt])
  @@map("fl_action_approvals")
  @@schema("fleethub")
}

// ─── PHASE 11 — WEBAUTHN + STEP-UP ──────────────────────────────────────────

/// Phase 11 WS-C. WebAuthn credentials per staff user. Multiple
/// allowed (one platform authenticator + one security key is the
/// typical pattern).
model Fl_WebAuthnCred {
  id             String    @id @default(cuid())
  userId         String
  /// Raw credentialId from the authenticator. Indexed for lookup.
  credentialId   Bytes     @unique
  publicKey      Bytes
  signCount      BigInt    @default(0)
  /// JSON array: usb | nfc | ble | internal
  transportsJson String?
  /// Operator-chosen label, e.g. "MacBook TouchID".
  name           String
  aaguid         Bytes?
  createdAt      DateTime  @default(now())
  lastUsedAt     DateTime?

  @@index([userId])
  @@map("fl_webauthn_creds")
  @@schema("fleethub")
}

/// Phase 11 WS-C. One-time replay-guard set for step-up tokens.
/// Token is HMAC-signed by Fl_CryptoKey purpose='step-up-signing'
/// with a unique jti; consumption writes the jti here. A new cron
/// purges rows past expMs.
model Fl_StepUpConsumed {
  jti          String    @id
  userId       String
  consumedAt   DateTime  @default(now())
  /// Token's own expMs — cron purges after expiry.
  expMs        BigInt

  @@index([expMs])
  @@map("fl_step_up_consumed")
  @@schema("fleethub")
}

// ─── PHASE 12 — EVALUATOR LEASE (WS-E.1) ────────────────────────────────────

/// Phase 12 WS-E.1. Atomic cron-throttling primitive. Each cron route
/// claims its name via INSERT...ON CONFLICT DO UPDATE WHERE
/// leasedUntil < now() RETURNING name. 0 rows = lease held by another
/// runner → 409 skip. Heartbeat extends leasedUntil mid-run. Survives
/// app restart (lease entries are rows, not in-process state). Also
/// powers the /api/health cron-stale detector (WS-E.6).
model Fl_EvaluatorLease {
  name          String   @id
  leasedAt      DateTime @default(now())
  leasedUntil   DateTime
  leasedBy      String
  heartbeatAt   DateTime @default(now())

  @@index([leasedUntil])
  @@map("fl_evaluator_leases")
  @@schema("fleethub")
}

// ─── PHASE 12 — NETWORK DEVICE MONITORING (WS-A) ────────────────────────────

/// Phase 12 WS-A. Switches / routers / APs / printers / UPS / etc.
/// monitored via ICMP and/or SNMP. SNMP creds resolved via Phase 11
/// vault (snmpCredentialId → Fl_Credential where kind='snmp-v3').
model Fl_NetworkDevice {
  id                String    @id @default(cuid())
  clientName        String
  displayName       String
  ipAddress         String
  kind              String    // switch | router | firewall | ap | printer | ups | other
  snmpVersion       String    @default("none") // none | v2c | v3
  snmpCredentialId  String?
  icmpEnabled       Boolean   @default(true)
  pollIntervalSec   Int       @default(60)
  tagsJson          String?
  isActive          Boolean   @default(true)
  lastProbedAt      DateTime?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  probes            Fl_NetworkProbe[]

  @@index([clientName, isActive])
  @@map("fl_network_devices")
  @@schema("fleethub")
}

/// Phase 12 WS-A fact-table. One row per probe attempt. Append-only.
/// Retention 90d (cron sweep ships BEFORE this table is populated per
/// PHASE-12-DESIGN.md §3 footgun 2). For >7d queries the rollup
/// table Fl_NetworkProbeHour is faster.
model Fl_NetworkProbe {
  id                String          @id @default(cuid())
  networkDeviceId   String
  device            Fl_NetworkDevice @relation(fields: [networkDeviceId], references: [id], onDelete: Cascade)
  ts                DateTime        @default(now())
  kind              String          // icmp | snmp-get | snmp-walk
  rttMs             Float?
  ok                Boolean
  errorMsg          String?
  payloadJson       String?

  @@index([networkDeviceId, ts(sort: Desc)])
  @@map("fl_network_probes")
  @@schema("fleethub")
}

/// Phase 12 WS-A materialized hourly rollup. Populated by
/// /api/cron/network-probe-rollup; NOT a view (architect gut-check
/// §5 — view re-scans on every chart render).
model Fl_NetworkProbeHour {
  networkDeviceId   String
  hour              DateTime
  p50Ms             Float?
  p95Ms             Float?
  p99Ms             Float?
  lossPct           Float
  sampleCount       Int

  @@id([networkDeviceId, hour])
  @@index([hour])
  @@map("fl_network_probe_hours")
  @@schema("fleethub")
}

// ─── PHASE 12 — MAINTENANCE WINDOWS (WS-B) ──────────────────────────────────

/// Phase 12 WS-B. Recurring or one-off windows during which the
/// /api/cron/maintenance-window-eval cron flips Fl_Device.maintenanceMode
/// (reuses Phase 3 plumbing — no new suppression code path) and
/// optionally marks active alerts state='suppressed' for matching kinds.
model Fl_MaintenanceWindow {
  id                       String    @id @default(cuid())
  tenantName               String
  name                     String
  /// RRULE-style cron ("every Sunday 02:00") — operators want recurring,
  /// not 52 rows.
  cron                     String
  durationMin              Int
  suppressAlertKindsJson   String?
  /// JSON: { deviceTags?: string[], deviceGroupId?: string }. Null = all
  /// devices in tenant.
  scopeJson                String?
  nextStart                DateTime?
  nextEnd                  DateTime?
  lastFiredAt              DateTime?
  isActive                 Boolean   @default(true)
  createdBy                String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@index([tenantName, isActive])
  @@index([nextStart])
  @@map("fl_maintenance_windows")
  @@schema("fleethub")
}

// ─── PHASE 12 — CRYPTO ROTATION (WS-C) ──────────────────────────────────────

/// Phase 12 WS-C. State of an in-flight or completed vault-KEK
/// rotation. Wraps the rewrapTenantCredentials background job so the
/// /admin/crypto/rotate wizard can poll progress and so concurrent
/// rotation attempts are blocked (state='in-progress' present → second
/// click refused).
model Fl_CryptoRotation {
  id            String    @id @default(cuid())
  purpose       String    // vault-kek | (future)
  fromVersion   Int
  toVersion     Int
  state         String    @default("in-progress") // in-progress | done | failed
  processed     Int       @default(0)
  total         Int       @default(0)
  currentTenant String?
  errorMsg      String?
  initiatedBy   String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([state, startedAt])
  @@map("fl_crypto_rotations")
  @@schema("fleethub")
}

// ─── PHASE 13 — DEPLOY-FROM-PANEL (WS-D.0) ──────────────────────────────────

/// Phase 13 WS-D.0. One-time agent bootstrap token. Operator generates
/// from /clients/[name]?tab=install; agent consumes via
/// POST /api/agent-ingest/enroll. 24h default TTL; 410-Gone on second
/// use. Token is a 32-byte hex string used as the PK.
model Fl_EnrollToken {
  token              String    @id // 64-char hex (32 bytes)
  tenantName         String
  createdBy          String
  createdAt          DateTime  @default(now())
  expiresAt          DateTime
  /// Single-use by default. Multi-use tokens are issued for bulk onboard
  /// runs (e.g. push a Syncro Script across N hosts). Token is fully
  /// consumed when useCount == maxUses; consumedAt is set at that point.
  maxUses            Int       @default(1)
  /// Incremented atomically on each successful enroll. Lives alongside
  /// consumedAt for back-compat — older read paths still see consumedAt
  /// as the "is fully spent" signal.
  useCount           Int       @default(0)
  consumedAt         DateTime?
  consumedByAgentId  String?
  consumedFromIp     String?

  @@index([tenantName, consumedAt])
  @@index([expiresAt])
  @@map("fl_enroll_tokens")
  @@schema("fleethub")
}

/// Phase 13 WS-D.0. Per-agent secret + tenant binding established at
/// bootstrap time. Replaces the shared FLEETHUB_AGENT_SECRET for hosts
/// that enroll via the panel (the shared secret stays valid for
/// legacy / manually-deployed agents). agentSecret is HMAC-shareable
/// — the gateway + posture routes accept it as Bearer.
model Fl_AgentRegistration {
  id              String    @id @default(cuid())
  tenantName      String
  hostname        String?
  os              String?
  osVersion       String?
  /// Bearer secret the agent presents on every call. Stored bcrypt-
  /// hashed (the agent has the plaintext from bootstrap response).
  agentSecretHash String
  enrolledAt      DateTime  @default(now())
  enrolledByToken String? // FK semantic to Fl_EnrollToken.token; nullable for manual enrollments
  lastSeenAt      DateTime?
  isRevoked       Boolean   @default(false)

  @@index([tenantName, isRevoked])
  @@map("fl_agent_registrations")
  @@schema("fleethub")
}

// ─── Wave B — saved views on /devices ─────────────────────────────────────
// Mirrors TicketHub TH_TicketView + TH_UserViewPreference 1:1. Filter
// shape + sort fields are FleetHub-specific (see lib/device-views.ts).
//
// Visibility uses the TH convention:
//   PERSONAL — owner-only; userId required, edit/delete locked to owner.
//   SHARED   — visible to all techs; only ADMINs can create/edit.
//   SYSTEM   — seeded on first /devices load; not editable.

model Fl_DeviceView {
  id            String   @id @default(cuid())
  name          String
  /// JSON: { q?, client?, os[]?, online?, role[]?, hasAlerts?,
  /// maintenance?, enrolled? }. See lib/device-views.ts ViewFilters type.
  filtersJson   String   @db.Text
  /// JSON: { field, direction } | null = default sort.
  sortJson      String?  @db.Text
  visibility    String   @default("PERSONAL") // PERSONAL | SHARED | SYSTEM
  /// Optional icon slug (lucide-name or emoji).
  icon          String?
  displayOrder  Int      @default(0)
  /// Owner. NULL for SYSTEM + SHARED. Enforces edit authz on PERSONAL.
  userId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([visibility, displayOrder])
  @@index([userId])
  @@map("fl_device_views")
  @@schema("fleethub")
}

model Fl_UserDevicePreference {
  id            String   @id @default(cuid())
  userId        String   @unique
  defaultViewId String
  /// Hideable column ids the user has hidden. Always-visible columns
  /// (checkbox, name) aren't tracked. Validated against allow-list
  /// server-side; unknowns dropped silently.
  hiddenColumns String[] @default([])
  /// Preferred order of hideable columns. Empty = canonical order.
  columnOrder   String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("fl_user_device_preferences")
  @@schema("fleethub")
}
